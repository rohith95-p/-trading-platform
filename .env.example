# =============================================================================
# trading-platform-backend — Environment Variable Reference
# =============================================================================
# Copy this file to .env.local for local development.
# On Railway, set these variables in the service's Variables tab.
#
# Railway service-reference syntax:  ${{ServiceName.VARIABLE}}
# This tells Railway to pull the value from another service at deploy time.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
ENVIRONMENT=production          # development | staging | production
DEBUG=False
LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
# URL of the Next.js frontend service.
# Railway (service reference): ${{trading-platform-frontend.RAILWAY_PUBLIC_DOMAIN}}
#   → Railway resolves this to the full https:// URL automatically.
# Local development: http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# Railway (service reference): ${{Postgres.DATABASE_URL}}
#   → Railway injects the full connection string from the Postgres service.
# Local development: postgresql://trading_user:trading_password@localhost:5432/trading_db
DATABASE_URL=postgresql://user:password@localhost:5432/trading_db

# -----------------------------------------------------------------------------
# Cache (Redis)
# -----------------------------------------------------------------------------
# Railway (service reference): ${{Redis.REDIS_URL}}
#   → Railway injects the full connection string from the Redis service.
# Local development: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
JWT_SECRET=change-this-to-a-random-32-char-string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=30

# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=change-this-to-a-random-32-byte-hex-key

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins.
# FRONTEND_BASE_URL and Railway domain variables (RAILWAY_PUBLIC_DOMAIN,
# RAILWAY_PRIVATE_DOMAIN) are automatically appended at startup — you do not
# need to duplicate them here.
#
# Example (Railway + local dev):
#   CORS_ORIGINS=https://trading-platform-frontend.up.railway.app,http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# -----------------------------------------------------------------------------
# Supabase (optional — for managed auth)
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# -----------------------------------------------------------------------------
# OAuth (optional)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Stripe (optional)
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=price_free_tier

# -----------------------------------------------------------------------------
# AI / ML APIs
# -----------------------------------------------------------------------------
# Anthropic Claude (news classification)
ANTHROPIC_API_KEY=

# OpenAI (simulation engine — falls back to mock if not set)
OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# Exchange APIs (all default to paper trading when keys are absent)
# -----------------------------------------------------------------------------
KALSHI_API_KEY=
KALSHI_API_SECRET=

POLYMARKET_API_KEY=

ALPACA_API_KEY=
ALPACA_API_SECRET=

HYPERLIQUID_API_KEY=
HYPERLIQUID_API_SECRET=

DYDX_API_KEY=
DYDX_API_SECRET=

KRAKEN_API_KEY=
KRAKEN_API_SECRET=

BINANCE_API_KEY=
BINANCE_API_SECRET=

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
ENABLE_PAPER_TRADING=true
ENABLE_REAL_TRADING=false       # Keep false until thoroughly tested in production
ENABLE_DRL_AGENT=true
ENABLE_SIMULATION=true
ENABLE_NEWS_CLASSIFICATION=true
