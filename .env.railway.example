# Railway Backend Environment Variables
# Copy this file and fill in the values, then add to Railway dashboard

# Application Environment
ENVIRONMENT=production
DEBUG=False
LOG_LEVEL=info

# Feature Flags
ENABLE_PAPER_TRADING=true
ENABLE_REAL_TRADING=false
ENABLE_DRL_AGENT=true
ENABLE_SIMULATION=true

# Database & Cache (Railway will provision these, but you can override)
DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}

# Supabase (Auth & DB)
SUPABASE_URL=<your-supabase-project-url>
SUPABASE_ANON_KEY=<your-supabase-anon-key>
SUPABASE_SERVICE_KEY=<your-supabase-service-role-key>

# Authentication & Security
JWT_SECRET=<generate-random-32-char-string>
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
ENCRYPTION_KEY=<generate-32-byte-hex-key>
CORS_ORIGINS=https://trading-platform.vercel.app,http://localhost:3000,http://localhost:8000

# AI Models (NVIDIA)
NVIDIA_API_KEY=<your-nvidia-api-key>

# Exchange APIs - Phase 1
KALSHI_API_KEY=<your-kalshi-api-key>
KALSHI_API_SECRET=<your-kalshi-api-secret>
POLYMARKET_API_KEY=<your-polymarket-api-key>
POLYMARKET_API_SECRET=<your-polymarket-api-secret>
ALPACA_API_KEY=<your-alpaca-api-key>
ALPACA_API_SECRET=<your-alpaca-secret-key>

# Exchange APIs - Phase 1.5
HYPERLIQUID_API_KEY=
HYPERLIQUID_API_SECRET=
DYDX_API_KEY=
DYDX_API_SECRET=
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
BINANCE_API_KEY=
BINANCE_API_SECRET=

# News Integration & Social
RSS_FEEDS=https://feeds.bloomberg.com/markets/news.rss,https://www.cnbc.com/id/100003114/device/rss/rss.html,https://feeds.reuters.com/reuters/businessNews
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_BEARER_TOKEN=
TWITTER_KEYWORDS=bitcoin,ethereum,crypto,trading,stocks
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_IDS=
NEWS_POLLING_INTERVAL=15

# Observability
BETTERSTACK_SOURCE_TOKEN=<your-betterstack-token>
