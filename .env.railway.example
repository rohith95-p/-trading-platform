# =============================================================================
# Railway Backend Environment Variables
# =============================================================================
# Set these in your Railway service's Variables tab.
# Values shown with ${{...}} use Railway's service reference syntax — Railway
# resolves them automatically from the linked service at deploy time.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
ENVIRONMENT=production
LOG_LEVEL=info
DEBUG=False

# -----------------------------------------------------------------------------
# Frontend service link
# -----------------------------------------------------------------------------
# Use a Railway service reference so this updates automatically when the
# frontend is redeployed to a new domain.
# Replace "trading-platform-frontend" with your actual frontend service name.
FRONTEND_BASE_URL=${{trading-platform-frontend.RAILWAY_PUBLIC_DOMAIN}}

# -----------------------------------------------------------------------------
# Database — Railway Postgres service reference
# -----------------------------------------------------------------------------
# Railway injects the full postgresql:// connection string automatically.
DATABASE_URL=${{Postgres.DATABASE_URL}}

# -----------------------------------------------------------------------------
# Cache — Railway Redis service reference
# -----------------------------------------------------------------------------
# Railway injects the full redis:// connection string automatically.
REDIS_URL=${{Redis.REDIS_URL}}

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# Generate: openssl rand -base64 32
JWT_SECRET=<generate-random-32-char-string>
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=30

# Generate: openssl rand -hex 32
ENCRYPTION_KEY=<generate-32-byte-hex-key>

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# FRONTEND_BASE_URL, RAILWAY_PUBLIC_DOMAIN, and RAILWAY_PRIVATE_DOMAIN are
# automatically appended to this list at startup — no need to duplicate them.
# Add any additional origins (e.g. Vercel preview URLs) here.
CORS_ORIGINS=https://trading-platform.vercel.app

# -----------------------------------------------------------------------------
# Supabase (optional)
# -----------------------------------------------------------------------------
SUPABASE_URL=<your-supabase-project-url>
SUPABASE_ANON_KEY=<your-supabase-anon-key>
SUPABASE_SERVICE_KEY=<your-supabase-service-role-key>

# -----------------------------------------------------------------------------
# External APIs
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=<your-claude-api-key>
KALSHI_API_KEY=<your-kalshi-api-key>
POLYMARKET_API_KEY=<your-polymarket-api-key>
ALPACA_API_KEY=<your-alpaca-api-key>
ALPACA_API_SECRET=<your-alpaca-secret-key>

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
ENABLE_PAPER_TRADING=true
ENABLE_REAL_TRADING=false
ENABLE_DRL_AGENT=true
ENABLE_SIMULATION=true
ENABLE_NEWS_CLASSIFICATION=true

# -----------------------------------------------------------------------------
# Logging (optional — Better Stack)
# -----------------------------------------------------------------------------
BETTERSTACK_SOURCE_TOKEN=<your-betterstack-token>
