# Development Environment Variables
# This file contains default values for local development
# Copy this to .env and customize as needed

# Application
DEBUG=True
LOG_LEVEL=DEBUG
ENVIRONMENT=development

# Database (Docker Compose)
POSTGRES_USER=trading_user
POSTGRES_PASSWORD=trading_password
POSTGRES_DB=trading_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://trading_user:trading_password@localhost:5432/trading_db

# Redis (Docker Compose)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Backend
BACKEND_PORT=8000

# JWT
JWT_SECRET=dev-secret-key-DO-NOT-USE-IN-PRODUCTION
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Encryption
ENCRYPTION_KEY=dev-encryption-key-DO-NOT-USE-IN-PRODUCTION

# Claude API (Optional for development)
ANTHROPIC_API_KEY=

# Exchange APIs (Optional for development - use paper trading)
KALSHI_API_KEY=
KALSHI_API_SECRET=
KALSHI_PAPER_TRADING=true

POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_PAPER_TRADING=true

ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_PAPER_TRADING=true

# Hyperliquid (Phase 1.5)
HYPERLIQUID_API_KEY=
HYPERLIQUID_API_SECRET=
HYPERLIQUID_PAPER_TRADING=true

# dYdX (Phase 1.5)
DYDX_API_KEY=
DYDX_API_SECRET=
DYDX_PAPER_TRADING=true

# Kraken (Phase 1.5)
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
KRAKEN_PAPER_TRADING=true

# Binance (Phase 1.5)
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_PAPER_TRADING=true

# Feature Flags
ENABLE_NEWS_CLASSIFICATION=false
ENABLE_MULTI_AGENT_SIM=false
ENABLE_DRL_AGENT=false

# Rate Limiting
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=100

# Monitoring
ENABLE_METRICS=true
ENABLE_TRACING=false
